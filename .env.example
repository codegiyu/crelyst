# Firebase Configuration (Client)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Firebase Admin SDK (Server-side only)
FIREBASE_ADMIN_PROJECT_ID=your_project_id
FIREBASE_ADMIN_CLIENT_EMAIL=your_service_account_email
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Application
APP_URL=http://localhost:3000
APP_NAME=Crelyst

# Optional: run Firestore seed on API boot (default: true in dev, false in production)
# SEED_FIRESTORE_ON_BOOT=true

# Shared secret for server webhooks (document verify, email bounce). Send header: x-webhook-secret
WEBHOOK_SECRET=change-me-in-production

# Email (for notifications, etc.)
FROM_EMAIL=hello@crelyst.com
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_PASSWORD=your_password
TO_EMAIL=admin@crelyst.com

# Cloudflare R2 Storage
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=crelyst
R2_CDN_URL=https://static.crelyst.com
# Also used by next.config.ts to allow this host in next/image (plus common R2/Unsplash/Firebase hosts).
R2_PUBLIC_URL=https://your_bucket.r2.dev
R2_FOLDER_PREFIX=development-files
