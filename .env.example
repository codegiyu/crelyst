# # =============================================================================
# # Firebase – client (exposed to the browser via NEXT_PUBLIC_*)
# # =============================================================================
# NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
# NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
# # Optional – Analytics (see lib/config/firebase.ts)
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# # =============================================================================
# # Firebase Admin – server only (service account)
# # =============================================================================
# FIREBASE_ADMIN_PROJECT_ID=your_project_id
# FIREBASE_ADMIN_CLIENT_EMAIL=your_service_account_email
# FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# # =============================================================================
# # Application URLs & name
# # =============================================================================
# # Public site URL (emails, seed data, ENVIRONMENT.APP)
# APP_URL=http://localhost:3000
# APP_NAME=Crelyst
# # Canonical / OG base URL for metadata (lib/constants/texts.ts – key is lowercase)
# live_url=http://localhost:3000
# # Preferred origin for server-side fetch to this app’s API routes (app/_server/lib/api/serverFetch.ts)
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# # =============================================================================
# # Firestore seed on API boot (app/_server/lib/init.ts)
# # Default: true in non-production, false in production unless overridden
# # =============================================================================
# # SEED_FIRESTORE_ON_BOOT=true

# # =============================================================================
# # Webhooks (document verify, email bounce) – header x-webhook-secret
# # =============================================================================
# WEBHOOK_SECRET=change-me-in-production

# # =============================================================================
# # Email (ENVIRONMENT.EMAIL + company overrides in environment.ts)
# # =============================================================================
# FROM_EMAIL=hello@crelyst.com
# MAIL_HOST=smtp.example.com
# MAIL_PORT=465
# MAIL_PASSWORD=your_password
# TO_EMAIL=admin@crelyst.com

# # Optional overrides for “crelyst” company branding block (same keys as above if unset)
# # COMPANY_CRELYST_EMAIL_TO=
# # COMPANY_CRELYST_EMAIL_PASSWORD=
# # COMPANY_CRELYST_EMAIL_HOST=
# # COMPANY_CRELYST_EMAIL_PORT=465

# # =============================================================================
# # Social defaults (ENVIRONMENT.COMPANIES.crelyst.socials)
# # =============================================================================
# # SOCIAL_X=
# # SOCIAL_INSTAGRAM=
# # SOCIAL_FACEBOOK=
# # SOCIAL_TIKTOK=
# # SOCIAL_LINKEDIN=

# # =============================================================================
# # Cloudflare R2 (uploads, presigned URLs, next/image remotePatterns)
# # =============================================================================
# R2_ACCOUNT_ID=your_account_id
# R2_ACCESS_KEY_ID=your_access_key_id
# R2_SECRET_ACCESS_KEY=your_secret_access_key
# R2_BUCKET_NAME=crelyst
# # Public asset base for URLs (CDN or r2.dev). Also used by next.config.ts for images.
# R2_CDN_URL=https://static.crelyst.com
# R2_PUBLIC_URL=https://your_bucket.r2.dev
# # Optional: same as R2_PUBLIC_URL but exposed to the client for image config if needed
# # NEXT_PUBLIC_R2_PUBLIC_URL=
# R2_FOLDER_PREFIX=development-files

# # =============================================================================
# # Bold Brand Studio portfolio integration (server only)
# # Admin “Publish to Bold Brand Studio” → Vercel Deploy Hook (lib/config/environment.ts)
# # =============================================================================
# # Create in Vercel: Project → Settings → Git → Deploy Hooks. Never expose in client bundle.
# BOLD_BRAND_STUDIO_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/prj_xxx/yyy

# # Comma-separated origins allowed on GET /api/public/portfolio-case-studies (CORS).
# # Defaults include localhost:5173 and bold-brand-studio*.vercel.app if unset.
# # BOLD_BRAND_STUDIO_ALLOWED_ORIGINS=http://localhost:5173,https://www.boldbrandstudio.com
