{
  "name": "crelyst",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:next": "next lint",
    "format": "prettier --write . --ignore-path .prettierignore",
    "format:check": "prettier --check . --ignore-path .prettierignore",
    "checks": "npm run lint && npm run format:check && npm run test:phase && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "node -e \"console.log('E2E not configured; skipping.')\"",
    "test:phase": "npm run test:unit && npm run test:integration",
    "test:phase:unit": "npm run test:unit",
    "test:phase:integration": "npm run test:integration",
    "test:phase:e2e": "npm run test:e2e",
    "migrate:case-study": "npx tsx scripts/migrate-project-case-study.ts",
    "migrate:bold-brand-studio": "npx tsx scripts/migrate-bold-brand-studio-content.ts",
    "migrate:isaac-service-content": "npx tsx scripts/migrate-isaac-service-content.ts",
    "generate:icons": "npx @svgr/cli --out-dir components/icons --ignore-existing --typescript --replace-attr-values #fff=currentColor,#000=currentColor --jsx-runtime automatic --icon -- public/icons",
    "seed": "npx tsx scripts/seed.ts",
    "deploy:firestore-indexes": "firebase deploy --only firestore:indexes",
    "deploy:firestore-rules": "firebase deploy --only firestore:rules"
  },
  "keywords": [
    "nextjs",
    "nextjs-16",
    "tailwindcss",
    "shadcn",
    "fullstack",
    "typescript",
    "firestore",
    "firebase",
    "cloudflare",
    "r2",
    "storage"
  ],
  "author": "Codegiyu",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.679.0",
    "@aws-sdk/s3-request-presigner": "^3.679.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-email/components": "^1.0.2",
    "@use-gesture/react": "^10.3.1",
    "axios": "^1.11.0",
    "bcrypt": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.2.2",
    "firebase": "^12.9.0",
    "firebase-admin": "^13.6.1",
    "isomorphic-dompurify": "^3.13.0",
    "libphonenumber-js": "^1.11.14",
    "lodash": "^4.17.21",
    "lucide-react": "^0.544.0",
    "motion": "^12.23.12",
    "nanoid": "^5.1.5",
    "next": "16.0.7",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "nodemailer": "^7.0.6",
    "nuqs": "^2.7.2",
    "ogl": "^1.0.11",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-email": "^5.1.0",
    "sonner": "^2.0.7",
    "swiper": "^11.2.10",
    "tailwind-merge": "^3.3.1",
    "ts-custom-error": "^3.3.1",
    "typescript": "^5",
    "winston": "^3.18.3",
    "zod": "^4.1.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@svgr/cli": "^8.1.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcrypt": "^6.0.0",
    "@types/crypto-js": "^4.2.2",
    "@types/google-libphonenumber": "^7.4.30",
    "@types/lodash": "^4.17.20",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/swiper": "^5.4.3",
    "@types/winston": "^2.4.4",
    "baseline-browser-mapping": "^2.9.19",
    "eslint": "^9",
    "eslint-config-next": "16.0.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "firebase-tools": "^13.0.0",
    "prettier": "^3.6.2",
    "sharp": "^0.34.4",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.8",
    "typescript-eslint": "^8.47.0",
    "vitest": "^3.2.4"
  }
}
